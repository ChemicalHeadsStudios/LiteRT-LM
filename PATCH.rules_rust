--- crate_universe/private/crates_repository.bzl	2025-05-01 16:41:19.000000000 -0700
+++ crate_universe/private/crates_repository.bzl	2025-06-19 10:31:33.225901444 -0700
@@ -28,6 +28,9 @@
 # complexity for each platform triple added.
 SUPPORTED_PLATFORM_TRIPLES = [
     "aarch64-apple-darwin",
+    "aarch64-apple-ios",
+    "aarch64-apple-ios-sim",
+    "aarch64-linux-android",
     "aarch64-unknown-linux-gnu",
     "wasm32-unknown-unknown",
     "wasm32-wasip1",


--- rust/toolchain.bzl
+++ rust/toolchain.bzl
@@ -47,7 +47,14 @@
     ]
     panic_files = []
 
-    std_rlibs = [f for f in rust_std if f.basename.endswith(".rlib")]
+    # profiler_builtins is the LLVM profile runtime for instrument-coverage builds.
+    # Linking it whole-archive registers an atexit hook that writes an empty
+    # default.profraw next to every process that loads the library.
+    std_rlibs = [
+        f
+        for f in rust_std
+        if f.basename.endswith(".rlib") and not f.basename.startswith("libprofiler_builtins")
+    ]
     if std_rlibs:
         # test depends on std
         # std depends on everything except test
