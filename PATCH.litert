+class LiteRtCallbackLoggerT final : public LiteRtLoggerT {
+ public:
+  LiteRtCallbackLoggerT(LiteRtLogCallback callback, void* user_data)
+      : callback_(callback), user_data_(user_data) {}
+
+  LiteRtLogSeverity GetMinSeverity() override { return min_severity_; }
+
+  void SetMinSeverity(LiteRtLogSeverity severity) override {
+    min_severity_ = severity;
+  }
+
+  void Log(LiteRtLogSeverity severity, const char* format,
+           va_list args) override {
+    va_list args2;
+    va_copy(args2, args);
+    const int len = vsnprintf(nullptr, 0, format, args);
+    std::string message;
+    if (len > 0) {
+      message.resize(len + 1);
+      vsnprintf(message.data(), len + 1, format, args2);
+      message.resize(len);
+    }
+    va_end(args2);
+    callback_(severity, message.c_str(), user_data_);
+  }
+
+  const char* GetIdentifier() const override { return "LiteRtCallbackLogger"; }
+
+ private:
+  LiteRtLogCallback callback_;
+  void* user_data_;
+  LiteRtLogSeverity min_severity_ = kLiteRtLogSeverityInfo;
+};
+
