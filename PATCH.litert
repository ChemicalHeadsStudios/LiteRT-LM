 }
 
+LiteRtStatus LiteRtCreateCallbackLogger(LiteRtLogCallback callback,
+                                        void* user_data, LiteRtLogger* logger) {
+  if (!callback || !logger) {
+    return kLiteRtStatusErrorInvalidArgument;
+  }
+  *logger = new LiteRtCallbackLoggerT(callback, user_data);
+  return kLiteRtStatusOk;
+}
