 // Use the library provided sink logger instead of creating a new one.
 LiteRtStatus LiteRtUseSinkLogger();
 
+// Creates a logger that hands each record passing its minimum severity to
+// `callback` as a formatted message, for hosts that carry runtime logging in
+// their own logging system. The host destroys it with LiteRtDestroyLogger once
+// it is no longer the default logger.
+typedef void (*LiteRtLogCallback)(LiteRtLogSeverity severity,
+                                  const char* message, void* user_data);
+LiteRtStatus LiteRtCreateCallbackLogger(LiteRtLogCallback callback,
+                                        void* user_data, LiteRtLogger* logger);
+
